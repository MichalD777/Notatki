<?xml version="1.0" encoding="utf-8"?>
<!-- Główny pionowy kontener ekranu notatek -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#F0F8FF"
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:ignore="HardcodedText">

    <TextView
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="Notatki"
        android:textColor="#0000CD"
        android:textSize="30sp" />

    <!-- Lista zapisanych notatek -->
    <ListView
        android:id="@+id/lista"
        android:layout_height="400dp"
        android:layout_width="match_parent" />

    <TextView
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="Dodanie notatki"
        android:textColor="#0000CD"
        android:textSize="30sp" />

    <!-- Formularz wprowadzania nowej notatki -->
    <TextView
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="Tytuł notatki:" />

    <EditText
        android:autofillHints="no"
        android:hint="Wpisz tytuł notatki"
        android:id="@+id/tytul"
        android:inputType="textCapSentences"
        android:layout_height="wrap_content"
        android:layout_width="match_parent" />

    <TextView
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="Treść notatki:" />

    <EditText
        android:autofillHints="no"
        android:hint="Wpisz treść notatki"
        android:id="@+id/tresc"
        android:inputType="textMultiLine|textCapSentences"
        android:layout_height="wrap_content"
        android:layout_width="match_parent" />

    <!-- Przycisk dodający nową notatkę do listy -->
    <Button
        android:id="@+id/dodaj"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:text="DODAJ"
        android:textColor="#0000CD" />

</LinearLayout>